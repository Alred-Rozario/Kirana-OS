# ==========================================
# Kirana-OS AWS Cloud Services Configuration
# 3 Cloud Services: AWS EC2, AWS S3, AWS CloudFront
# ==========================================

# 1. AWS Credentials & Region
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# 2. AWS S3 (Object Storage)
S3_BUCKET_NAME=kirana-os-storage-mumbai

# 3. AWS CloudFront (Content Delivery Network CDN)
CLOUDFRONT_DOMAIN=d1k1rana0s.cloudfront.net
CLOUDFRONT_DISTRIBUTION_ID=E1A2B3C4D5E6F7

# 4. AWS EC2 (Instance Information)
EC2_INSTANCE_ID=i-09a8b7c6d5e4f3a21

# Flask / JWT Secrets
JWT_SECRET_KEY=kirana-os-saas-super-secret-key
FLASK_ENV=production

